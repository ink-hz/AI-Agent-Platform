+                "source_kind": "archive",
+                "content_note": "归档没有可确认的岗位正文。",
+            },
+        ],
+    }
+    company_body = _canonical(company) + b"\n"
+    (root / "sample.json").write_bytes(company_body)
+    manifest = {
+        "schema_version": 1,
+        "source_bundle_id": "2ed2262c-63a0-47e5-996c-7d00eb0be1a0",
+        "observed_at": "2026-09-06T14:00:00+00:00",
+        "job_count": 2,
+        "companies": [
+            {
+                **company["company"],
