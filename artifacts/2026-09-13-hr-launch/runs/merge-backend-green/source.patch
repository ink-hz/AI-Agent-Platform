+                "requirement": "1. 本科\n2. 光学专业",
+                "fields": [{"label": "学历", "value": "本科"}],
+                "evidence_sha256": "b" * 64,
+                "public_job_key": "public-1",
+                "source_kind": "job",
+                "content_note": "正文已从确定归档岗位记录恢复并保留段落。",
+            },
