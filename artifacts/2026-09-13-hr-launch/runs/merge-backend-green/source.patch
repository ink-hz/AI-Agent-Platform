+    assert catalog["observed_at"] == "2026-09-06T14:11:24.097448+00:00"
+    assert catalog["job_count"] == 3437
+    assert len(catalog["companies"]) == 12
+    assert sum(item["job_count"] for item in catalog["companies"]) == 3437
