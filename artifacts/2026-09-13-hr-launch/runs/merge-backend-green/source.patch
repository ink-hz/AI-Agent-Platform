+                "channel": "社会招聘",
+                "source_url": "https://example.com/jobs",
+                "state": "succeeded",
+                "observed_at": "2026-09-06T14:00:00+00:00",
+                "job_count": 2,
+                "error_code": None,
+            }
+        ],
+        "limitations": [],
+        "jobs": [
+            {
+                "job_id": "00000000-0000-0000-0000-000000000001",
