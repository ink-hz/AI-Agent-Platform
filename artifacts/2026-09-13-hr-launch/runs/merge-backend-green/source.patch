+    assert page["locations"] == ["上海", "深圳"]
+    assert page["channel_options"] == ["社会招聘"]
+    assert page["items"] == [
+        {
+            key: company_value
+            for key, company_value in company["jobs"][0].items()
+            if key
+            in {
