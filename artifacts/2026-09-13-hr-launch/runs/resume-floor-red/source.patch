+        from starlette.concurrency import run_in_threadpool
+
+        from app.hr_agent.readiness import unavailable
+
+        context: AuthContext = request.state.auth_context
+        if context.role is not Role.PLATFORM_OWNER:
+            raise HTTPException(403, "platform owner required")
+        audit = getattr(request.app.state, "system_health_audit", None)
+        if audit is None:
+            raise HTTPException(503, "required audit unavailable")
+        try:
+            await run_in_threadpool(audit, context)
+        except Exception:
+            raise HTTPException(503, "required audit unavailable") from None
+        probe = getattr(request.app.state, "hr_readiness", None)
+        try:
+            payload = await run_in_threadpool(probe.check) if probe is not None else unavailable()
+        except Exception:
+            payload = unavailable("readiness_unavailable")
+        return JSONResponse(payload, status_code=200 if payload["ready"] else 503,
+                            headers=_NO_STORE)
