 .hr-research-state{padding:50px 22px;text-align:center;color:#455f70;font-size:14px;line-height:1.9}.hr-research-state button,.hr-research-state a{border:1px solid #cadce3;background:#ffffff9e;border-radius:9px;margin:12px 6px;padding:9px 15px;color:#24586c;cursor:pointer;font-size:13px}.hr-research-archive-banner{padding:15px 28px;color:#455f70;font-size:12px;background:#ecf2f880}.hr-research-archive-banner a{float:right;color:#24586c}.hr-research button:focus-visible,.hr-research a:focus-visible,.hr-research input:focus-visible,.hr-research summary:focus-visible{outline:2px solid #488ea0;outline-offset:4px}
