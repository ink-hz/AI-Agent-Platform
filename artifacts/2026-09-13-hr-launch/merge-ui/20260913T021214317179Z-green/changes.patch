+    .mockResolvedValueOnce({ items: [manual], nextCursor: "loop" });
+  await act(async () => root.render(<HrPositionIndex account={account} api={api({ listPositions }) as never} />));
+  expect(container.textContent).toContain("岗位数据暂时不可用");
+  expect(listPositions).toHaveBeenCalledTimes(2);
+});
