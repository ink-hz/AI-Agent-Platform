+        (
+            ("platform_control_app", "platform_control_app", "agent_platform_control"),
+            None,
+            (True, True, True, True),
+        ),
+        (
+            ("platform_control_app", "platform_control_app", "agent_platform_control"),
+            ("0" * 64,),
+            (True, True, True, True),
+        ),
+        (
+            ("platform_control_maintenance", "platform_control_maintenance", "agent_platform_control"),
+            (ATTACHMENT_FENCE_MIGRATION_SHA256,),
+            (True, True, True, True),
+        ),
+        (
+            ("platform_control_app", "platform_control_app", "agent_platform_control"),
+            (ATTACHMENT_FENCE_MIGRATION_SHA256,),
+            (True, True, False, True),
