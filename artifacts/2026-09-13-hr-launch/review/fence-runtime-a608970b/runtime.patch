+    with pytest.raises(AttachmentFenceCapabilityError):
+        worker_runtime.build_processor(content_codec=object(), client=object())
+    with pytest.raises(AttachmentFenceCapabilityError):
+        worker_runtime.build_maintenance_services(
+            content_codec=object(), object_store=object()
