+        state = admin.execute(
+            "select state,state_reason from platform_attachments.attachments "
+            "where attachment_id=%s",
+            (attachment_id,),
+        ).fetchone()
+    assert len(rows) == 1 and rows[0][1] == "preview"
+    assert state == ("deleted", "erasure_pending")
