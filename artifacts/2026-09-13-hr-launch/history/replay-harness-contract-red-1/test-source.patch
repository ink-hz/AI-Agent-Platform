+@pytest.mark.postgres
+def test_h03_one_combined_jd_jr_result_is_retrievable_and_revised_in_place(tmp_path):
+    report = harness().replay_case(
+        CORPUS, "H03", tmp_path / "runtime", tmp_path / "evidence"
+    )
+    assert report["status"] == "completed", report
+    turns = report["turns"]
+    assert len(turns) == 4
+    assert report["security"] == {
+        "anonymous": 401,
+        "csrf": 403,
+        "origin": 403,
+        "wrong_owner": 404,
+    }
+    assert all(
+        turn["http"] == {
+            "submit": 201 if index == 0 else 202,
+            "replay": 200 if index == 0 else 202,
+            "work": 200,
+        }
+        for index, turn in enumerate(turns)
+    )
+    assert len({turn["persisted"]["work"]["work_id"] for turn in turns}) == 1
+    assert [turn["persisted"]["work"]["input_revision"] for turn in turns] == [
+        1,
+        2,
+        3,
+        4,
+    ]
+    results = [turn["persisted"]["results"] for turn in turns]
+    assert all(len(items) == 1 and items[0]["kind"] == "jd" for items in results)
+    assert all("JD" in items[0]["body"] and "JR" in items[0]["body"] for items in results)
+    refs = [turn["persisted"]["work"]["result_refs"][0] for turn in turns]
+    assert len({ref["id"] for ref in refs}) == 1
+    assert len({ref["revision"] for ref in refs}) == 4
+    assert len({ref["sha256"] for ref in refs}) == 4
+    for previous, turn in pairwise(turns):
+        assert previous["persisted"]["work"]["result_refs"][0] in turn["request"][
+            "references"
+        ]
+    material_ref = turns[0]["materials"][0]["ref"]
+    assert any(
+        call["namespace"] == "tool:read_resource"
+        and call["status"] == "committed"
+        and call["receipt"]["data"]["ref"] == material_ref
+        and call["receipt"]["data"]["coverage_complete"] is True
+        for call in turns[0]["persisted"]["tools"]
+    )
+    assert all(material_ref in items[0]["source_refs"] for items in results)
+
+
+@pytest.mark.postgres
+def test_h13_complete_conversation_answer_needs_no_saved_result(tmp_path):
+    report = harness().replay_case(
+        CORPUS, "H13", tmp_path / "runtime", tmp_path / "evidence"
+    )
+    assert report["status"] == "completed", report
+    assert report["security"] == {
+        "anonymous": 401,
+        "csrf": 403,
+        "origin": 403,
+        "wrong_owner": 404,
+    }
+    turn = report["turns"][0]
+    assert turn["http"] == {"submit": 201, "replay": 200, "work": 200}
+    assert turn["persisted"]["work"]["state"] == "completed"
+    assert turn["persisted"]["work"]["answer_state"] == "ended"
+    assert turn["persisted"]["work"]["result_refs"] == []
+    assert turn["persisted"]["results"] == []
+    answers = [
+        item
+        for item in turn["persisted"]["messages"]["items"]
+        if item["kind"] == "assistant" and item["visibility"] == "available"
+    ]
+    assert len(answers) == 1
+    assert all(marker in answers[0]["body"] for marker in ("数据事实", "解释假设", "需补证"))
+    material_ref = turn["materials"][0]["ref"]
+    assert any(
+        call["namespace"] == "tool:read_resource"
+        and call["status"] == "committed"
+        and call["receipt"]["data"]["ref"] == material_ref
+        and call["receipt"]["data"]["coverage_complete"] is True
+        for call in turn["persisted"]["tools"]
+    )
+    assert not any(
+        call["namespace"] == "tool:save_result"
+        for call in turn["persisted"]["tools"]
+    )
+
