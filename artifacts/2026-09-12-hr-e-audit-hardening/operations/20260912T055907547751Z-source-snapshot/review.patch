+                    "runbookSha256": sha256(RUNBOOK.read_bytes()).hexdigest(),
+                    "action": "transition", "target": "cloud", "statementTimeout": "3s",
+                    "exclusiveLockObserved": locked, "nonHrSharedLockWaitObserved": blocked,
