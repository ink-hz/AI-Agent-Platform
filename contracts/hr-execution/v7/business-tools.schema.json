          "pattern": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      },
      "required": [
        "readId",
        "contentSha256",
        "kind",
        "contextVersionId"
      ],
      "title": "ConfirmedBaseline",
      "type": "object"
    },
    "HrAnalysisResult": {
