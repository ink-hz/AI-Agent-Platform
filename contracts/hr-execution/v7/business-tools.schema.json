        "baselineRefs": {
          "items": {
            "discriminator": {
              "mapping": {
                "confirmed_standard": "#/$defs/ConfirmedBaseline",
                "official_position": "#/$defs/OfficialBaseline",
                "user_material": "#/$defs/MaterialBaseline"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/ConfirmedBaseline"
              },
              {
                "$ref": "#/$defs/OfficialBaseline"
              },
              {
                "$ref": "#/$defs/MaterialBaseline"
              }
