{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent.orbbec.com.cn/contracts/hr-execution/v5/runtime-config.schema.json",
  "title": "HR Local Execution Runtime Configuration Fixture",
  "$comment": "This fixture carries file paths only. Runtime ownership, 0700/0600 modes, no-symlink checks, PostgreSQL role scope, and loopback connectivity are downstream semantic preflight checks.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "botName", "executionRuntime", "capabilityGate"],
  "properties": {
    "schemaVersion": {"const": 2},
    "botName": {"const": "hr-bot"},
    "executionRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "databaseUrlFile", "databaseSchema", "relayBridgeUrl",
        "relayBridgeCredentialFile"
      ],
      "properties": {
        "databaseUrlFile": {"type": "string", "pattern": "^/", "maxLength": 1024},
        "databaseSchema": {"const": "hr_runtime"},
        "relayBridgeUrl": {"const": "http://127.0.0.1:9120/hr-bridge/v1"},
        "relayBridgeCredentialFile": {"type": "string", "pattern": "^/", "maxLength": 1024}
      }
    },
    "capabilityGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredContract", "reportedContract", "reasonCode"],
      "properties": {
        "requiredContract": {"const": "core_chat_collaboration_v5"},
        "reportedContract": {"const": "core_chat_collaboration_v4"},
        "reasonCode": {"const": "executor_capability_missing"}
      }
    }
  }
}
