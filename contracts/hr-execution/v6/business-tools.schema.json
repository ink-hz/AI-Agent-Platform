        "methodSteps": {
          "items": {
            "$ref": "#/$defs/HrMethodStep"
          },
          "maxItems": 100,
          "title": "Methodsteps",
          "type": "array"
        }
      },
      "required": [
        "schemaId",
        "title",
        "markdown",
        "sourceRefs",
        "methodSteps"
      ],
      "title": "HrAnalysisResult",
      "type": "object"
    },
