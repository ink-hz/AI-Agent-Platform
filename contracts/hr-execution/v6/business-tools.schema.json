    "HrCandidateEvidence": {
      "additionalProperties": false,
      "properties": {
        "positionCandidateId": {
          "format": "uuid",
          "title": "Positioncandidateid",
          "type": "string",
          "pattern": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
