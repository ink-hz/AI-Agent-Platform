          "default": null,
          "title": "Last Activity At"
        },
        "outcome_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Outcome Counts",
          "type": "object"
        }
      },
      "required": [
        "retained",
        "window"
      ],
      "title": "Usage",
      "type": "object"
    },
    "Window": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "timezone": {
          "const": "Asia/Shanghai",
          "default": "Asia/Shanghai",
          "title": "Timezone",
          "type": "string"
        },
        "days": {
          "anyOf": [
            {
              "enum": [
                7,
                30
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Days"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "Window",
      "type": "object"
    }
