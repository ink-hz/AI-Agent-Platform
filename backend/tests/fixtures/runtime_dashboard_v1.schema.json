        "abnormal": {
          "default": 0,
          "title": "Abnormal",
          "type": "integer"
        },
        "unknown": {
          "default": 0,
          "title": "Unknown",
          "type": "integer"
        },
        "observed_runtime": {
          "default": 0,
          "title": "Observed Runtime",
          "type": "integer"
        },
        "expected_runtime": {
          "default": 5,
          "title": "Expected Runtime",
          "type": "integer"
        },
        "covered_sources": {
          "default": 0,
          "title": "Covered Sources",
          "type": "integer"
        },
        "expected_sources": {
          "default": 5,
          "title": "Expected Sources",
          "type": "integer"
        },
        "status": {
          "default": "unavailable",
          "enum": [
            "complete",
            "partial",
            "unavailable"
