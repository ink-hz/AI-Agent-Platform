          "type": "string"
        },
        "entry_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entry Path"
        },
        "can_use": {
          "default": false,
          "title": "Can Use",
          "type": "boolean"
        },
        "runtime": {
          "$ref": "#/$defs/RuntimeEvidence"
        },
        "source": {
          "$ref": "#/$defs/SourceEvidence"
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        },
        "business_metrics": {
          "additionalProperties": {
            "$ref": "#/$defs/Metric"
          },
          "title": "Business Metrics",
          "type": "object"
        },
        "business_sources": {
          "additionalProperties": {
            "$ref": "#/$defs/SourceEvidence"
          },
          "title": "Business Sources",
          "type": "object"
        },
        "deployment": {
          "$ref": "#/$defs/Deployment"
        },
        "dataset": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dataset"
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "source",
        "usage"
      ],
      "title": "Application",
      "type": "object"
    },
    "Channel": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "agent_id": {
          "title": "Agent Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/SourceEvidence"
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        },
        "configured": {
          "default": true,
          "title": "Configured",
          "type": "boolean"
        },
        "records_path": {
          "title": "Records Path",
          "type": "string"
        }
      },
      "required": [
        "id",
        "agent_id",
        "name",
        "source",
        "usage",
        "records_path"
      ],
      "title": "Channel",
      "type": "object"
    },
    "Counts": {
      "additionalProperties": false,
      "properties": {
        "sessions": {
          "$ref": "#/$defs/Metric"
        },
        "turns": {
          "$ref": "#/$defs/Metric"
        },
        "answered_turns": {
          "$ref": "#/$defs/Metric"
        },
        "deliveries": {
          "$ref": "#/$defs/Metric"
        }
      },
      "required": [
        "sessions",
        "turns",
        "answered_turns",
        "deliveries"
      ],
      "title": "Counts",
      "type": "object"
    },
    "Deployment": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "observed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed At"
        },
        "evidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence"
        }
      },
      "title": "Deployment",
      "type": "object"
    },
    "Inventory": {
      "additionalProperties": false,
      "properties": {
        "applications": {
          "title": "Applications",
          "type": "integer"
        },
        "agent_services": {
          "title": "Agent Services",
          "type": "integer"
        },
        "business_workspaces": {
          "title": "Business Workspaces",
          "type": "integer"
        },
        "configured_agents": {
          "title": "Configured Agents",
          "type": "integer"
        },
        "channel_agents": {
          "title": "Channel Agents",
          "type": "integer"
        },
        "legacy_streams": {
          "title": "Legacy Streams",
          "type": "integer"
        }
