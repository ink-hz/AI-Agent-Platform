          "type": "string"
        },
        "reader_role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reader Role"
        },
        "input_time_basis": {
          "anyOf": [
            {
              "enum": [
                "question_at",
                "record_created_at",
                "mixed",
                "inputs_created_at"
