      },
      "title": "Legacy Streams",
      "type": "array"
    },
    "trend": {
      "items": {
        "$ref": "#/$defs/Trend"
      },
      "title": "Trend",
      "type": "array"
    },
    "last_24h": {
      "$ref": "#/$defs/Counts"
    },
    "ranking": {
      "items": {
        "$ref": "#/$defs/Ranking"
      },
      "title": "Ranking",
      "type": "array"
    }
