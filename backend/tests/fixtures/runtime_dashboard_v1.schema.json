              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Time Basis"
        },
        "missing_question_time_records": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing Question Time Records"
        }
      },
      "required": [
        "source_id",
        "source_kind"
