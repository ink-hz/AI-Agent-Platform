      "required": [
        "applications",
        "agent_services",
        "business_workspaces",
        "configured_agents",
        "channel_agents",
        "legacy_streams"
      ],
      "title": "Inventory",
      "type": "object"
    },
    "Metric": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "status": {
          "default": "unavailable",
          "enum": [
            "observed",
            "partial",
            "unavailable",
            "not_applicable"
          ],
          "title": "Status",
          "type": "string"
        },
        "unit": {
          "enum": [
            "session",
            "turn",
            "delivery",
            "work",
            "result",
            "document",
            "project",
            "task",
            "application",
            "agent"
          ],
          "title": "Unit",
          "type": "string"
        },
        "definition": {
          "title": "Definition",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "unit",
        "definition"
      ],
      "title": "Metric",
      "type": "object"
    },
    "Ranking": {
      "additionalProperties": false,
      "properties": {
        "application_id": {
          "title": "Application Id",
          "type": "string"
