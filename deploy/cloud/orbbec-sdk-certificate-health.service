[Unit]
Description=Read-only SDK IP certificate and renewal health check
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 /opt/orbbec-agent-platform/maintenance/current-certificate/certificate_health.py --warning-hours 24 --max-check-age-hours 26
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077
TimeoutStartSec=45
