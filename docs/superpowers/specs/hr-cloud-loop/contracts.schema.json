{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orbbec:hr-agent:a0:contracts",
  "$defs": {
    "ObjectRef": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "position",
            "candidate",
            "company",
            "topic"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "ExactRef": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "material",
            "method",
            "result",
            "intelligence",
            "standard"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "kind",
        "id",
        "revision",
        "sha256"
      ],
      "additionalProperties": false
    },
    "BudgetLimits": {
      "type": "object",
      "properties": {
        "model_calls": {
          "type": "integer",
          "minimum": 1
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "active_seconds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "model_calls",
        "total_tokens",
        "active_seconds"
      ],
      "additionalProperties": false
    },
    "BudgetAddition": {
      "type": "object",
      "properties": {
        "model_calls": {
          "type": "integer",
          "minimum": 0
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "active_seconds": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "model_calls",
        "total_tokens",
        "active_seconds"
      ],
      "additionalProperties": false
    },
    "WorkInput": {
      "type": "object",
      "properties": {
        "thread_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "objects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjectRef"
          }
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExactRef"
          }
        },
        "budget_profile": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "thread_id",
        "text",
        "objects",
        "references",
        "budget_profile"
      ],
      "additionalProperties": false
    },
    "AppendInput": {
      "type": "object",
      "properties": {
        "expected_input_revision": {
          "type": "integer",
          "minimum": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "objects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjectRef"
          }
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExactRef"
          }
        },
        "question_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "expected_input_revision",
        "text",
        "objects",
        "references",
        "question_id"
      ],
      "additionalProperties": false
    },
    "CancelInput": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "reason"
      ],
      "additionalProperties": false
    },
    "ExtendBudgetInput": {
      "type": "object",
      "properties": {
        "expected_budget_revision": {
          "type": "integer",
          "minimum": 1
        },
        "addition": {
          "$ref": "#/$defs/BudgetAddition"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "expected_budget_revision",
        "addition",
        "reason"
      ],
      "additionalProperties": false
    },
    "LinkResultInput": {
      "type": "object",
      "properties": {
        "expected_result_revision": {
          "type": "string",
          "format": "uuid"
        },
        "objects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjectRef"
          }
        }
      },
      "required": [
        "expected_result_revision",
        "objects"
      ],
      "additionalProperties": false
    },
    "ConfirmInput": {
      "type": "object",
      "properties": {
        "proposal_ref": {
          "$ref": "#/$defs/ExactRef"
        },
        "selected_change_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "expected_standard_revision": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "proposal_ref",
        "selected_change_ids",
        "expected_standard_revision"
      ],
      "additionalProperties": false
    },
    "Change": {
      "type": "object",
      "properties": {
        "change_id": {
          "type": "string",
          "format": "uuid"
        },
        "action": {
          "type": "string",
          "enum": [
            "add",
            "replace",
            "remove"
          ]
        },
        "target_item_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "change_id",
        "action",
        "target_item_id",
        "text"
      ],
      "additionalProperties": false
    },
    "ListResourcesInput": {
      "type": "object",
      "properties": {
        "kinds": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "material",
              "method",
              "result",
              "intelligence",
              "standard"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "objects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjectRef"
          }
        },
        "query": {
          "type": "string"
        },
        "cursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kinds"
      ],
      "additionalProperties": false
    },
    "ReadResourceInput": {
      "type": "object",
      "properties": {
        "ref": {
          "$ref": "#/$defs/ExactRef"
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000
        }
      },
      "required": [
        "ref"
      ],
      "additionalProperties": false
    },
    "SaveNoteInput": {
      "type": "object",
      "properties": {
        "body": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExactRef"
          }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "body",
        "source_refs",
        "open_questions"
      ],
      "additionalProperties": false
    },
    "SaveResultInput": {
      "type": "object",
      "properties": {
        "result_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "expected_revision": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "role_calibration",
            "jd",
            "requirements",
            "standard_proposal",
            "sourcing",
            "candidate_assessment",
            "interview_plan",
            "interview_record",
            "retrospective",
            "research"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string",
          "minLength": 1
        },
        "objects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjectRef"
          }
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExactRef"
          }
        },
        "preceding_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExactRef"
          }
        },
        "base_standard_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExactRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProposedChange"
          }
        }
      },
      "required": [
        "result_id",
        "expected_revision",
        "kind",
        "title",
        "body",
        "objects",
        "source_refs",
        "preceding_refs",
        "base_standard_ref",
        "changes"
      ],
      "additionalProperties": false
    },
    "AskUserInput": {
      "type": "object",
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "question",
        "options"
      ],
      "additionalProperties": false
    },
    "ResourceItem": {
      "type": "object",
      "properties": {
        "ref": {
          "$ref": "#/$defs/ExactRef"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "objects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjectRef"
          }
        },
        "description": {
          "type": "string"
        },
        "observed_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "ref",
        "title",
        "objects",
        "description",
        "observed_at"
      ],
      "additionalProperties": false
    },
    "ResourcePage": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResourceItem"
          }
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "items",
        "next_cursor"
      ],
      "additionalProperties": false
    },
    "ResourceText": {
      "type": "object",
      "properties": {
        "ref": {
          "$ref": "#/$defs/ExactRef"
        },
        "text": {
          "type": "string"
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        },
        "total_characters": {
          "type": "integer",
          "minimum": 0
        },
        "next_offset": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "read_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "ref",
        "text",
        "offset",
        "end",
        "total_characters",
        "next_offset",
        "read_id"
      ],
      "additionalProperties": false
    },
    "NoteReceipt": {
      "type": "object",
      "properties": {
        "entry_id": {
          "type": "string",
          "format": "uuid"
        },
        "saved": {
          "const": true
        }
      },
      "required": [
        "entry_id",
        "saved"
      ],
      "additionalProperties": false
    },
    "ResultReceipt": {
      "type": "object",
      "properties": {
        "result_ref": {
          "$ref": "#/$defs/ExactRef"
        },
        "saved": {
          "const": true
        }
      },
      "required": [
        "result_ref",
        "saved"
      ],
      "additionalProperties": false
    },
    "QuestionReceipt": {
      "type": "object",
      "properties": {
        "question_id": {
          "type": "string",
          "format": "uuid"
        },
        "state": {
          "const": "waiting_user"
        }
      },
      "required": [
        "question_id",
        "state"
      ],
      "additionalProperties": false
    },
    "Problem": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "not_found",
            "invalid_input",
            "scope_denied",
            "reference_unavailable",
            "hash_mismatch",
            "temporarily_unavailable",
            "idempotency_conflict",
            "revision_conflict",
            "lease_lost",
            "cancelled",
            "budget_exhausted",
            "configuration_unavailable",
            "dependency_revoked",
            "unsupported_kind"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {
          "type": "object",
          "properties": {
            "field": {
              "type": "string"
            },
            "current_revision": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "code",
        "message",
        "retryable",
        "details"
      ],
      "additionalProperties": false
    },
    "ListResourcesOutput": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "ok"
            },
            "data": {
              "$ref": "#/$defs/ResourcePage"
            },
            "error": {
              "type": "null"
            }
          },
          "required": [
            "status",
            "data",
            "error"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "missing",
                "unavailable",
                "forbidden",
                "conflict",
                "invalid"
              ]
            },
            "data": {
              "type": "null"
            },
            "error": {
              "$ref": "#/$defs/Problem"
            }
          },
          "required": [
            "status",
            "data",
            "error"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "empty"
            },
            "data": {
              "$ref": "#/$defs/ResourcePage"
            },
            "error": {
              "type": "null"
            }
          },
          "required": [
            "status",
            "data",
            "error"
          ],
          "additionalProperties": false
        }
      ]
    },
    "ReadResourceOutput": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "ok"
            },
            "data": {
              "$ref": "#/$defs/ResourceText"
            },
            "error": {
              "type": "null"
            }
          },
          "required": [
            "status",
            "data",
            "error"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "missing",
                "unavailable",
                "forbidden",
                "conflict",
                "invalid"
              ]
            },
            "data": {
              "type": "null"
            },
            "error": {
              "$ref": "#/$defs/Problem"
            }
          },
          "required": [
            "status",
            "data",
            "error"
          ],
          "additionalProperties": false
        }
      ]
    },
    "SaveNoteOutput": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "ok"
            },
            "data": {
              "$ref": "#/$defs/NoteReceipt"
            },
            "error": {
              "type": "null"
            }
          },
          "required": [
            "status",
            "data",
            "error"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "missing",
                "unavailable",
                "forbidden",
                "conflict",
                "invalid"
              ]
            },
            "data": {
              "type": "null"
            },
            "error": {
              "$ref": "#/$defs/Problem"
            }
          },
          "required": [
            "status",
            "data",
            "error"
          ],
          "additionalProperties": false
        }
      ]
    },
    "SaveResultOutput": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "ok"
            },
            "data": {
              "$ref": "#/$defs/ResultReceipt"
            },
            "error": {
              "type": "null"
            }
          },
          "required": [
            "status",
            "data",
            "error"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "missing",
                "unavailable",
                "forbidden",
                "conflict",
                "invalid"
              ]
            },
            "data": {
              "type": "null"
            },
            "error": {
              "$ref": "#/$defs/Problem"
            }
          },
          "required": [
            "status",
            "data",
            "error"
          ],
          "additionalProperties": false
        }
      ]
    },
    "AskUserOutput": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "ok"
            },
            "data": {
              "$ref": "#/$defs/QuestionReceipt"
            },
            "error": {
              "type": "null"
            }
          },
          "required": [
            "status",
            "data",
            "error"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "missing",
                "unavailable",
                "forbidden",
                "conflict",
                "invalid"
              ]
            },
            "data": {
              "type": "null"
            },
            "error": {
              "$ref": "#/$defs/Problem"
            }
          },
          "required": [
            "status",
            "data",
            "error"
          ],
          "additionalProperties": false
        }
      ]
    },
    "BudgetView": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "limits": {
          "$ref": "#/$defs/BudgetLimits"
        },
        "charged_calls": {
          "type": "integer",
          "minimum": 0
        },
        "charged_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "active_seconds": {
          "type": "number",
          "minimum": 0
        },
        "usage_quality": {
          "type": "string",
          "enum": [
            "reported",
            "estimated",
            "mixed"
          ]
        },
        "reserve": {
          "$ref": "#/$defs/BudgetAddition"
        }
      },
      "required": [
        "revision",
        "limits",
        "charged_calls",
        "charged_tokens",
        "active_seconds",
        "usage_quality",
        "reserve"
      ],
      "additionalProperties": false
    },
    "WorkView": {
      "type": "object",
      "properties": {
        "work_id": {
          "type": "string",
          "format": "uuid"
        },
        "thread_id": {
          "type": "string",
          "format": "uuid"
        },
        "input_revision": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "type": "string",
          "enum": [
            "queued",
            "running",
            "waiting_user",
            "waiting_budget",
            "completed",
            "cancelled",
            "failed",
            "blocked"
          ]
        },
        "answer_state": {
          "type": "string",
          "enum": [
            "none",
            "partial",
            "ended"
          ]
        },
        "result_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExactRef"
          }
        },
        "pending_question_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "block_reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "budget": {
          "$ref": "#/$defs/BudgetView"
        },
        "last_event_seq": {
          "type": "integer",
          "minimum": 0
        },
        "phase": {
          "enum": [
            "research",
            "finalizing"
          ]
        }
      },
      "required": [
        "work_id",
        "thread_id",
        "input_revision",
        "state",
        "answer_state",
        "result_refs",
        "pending_question_id",
        "block_reason",
        "budget",
        "last_event_seq",
        "phase"
      ],
      "additionalProperties": false
    },
    "ResultView": {
      "type": "object",
      "properties": {
        "ref": {
          "$ref": "#/$defs/ExactRef"
